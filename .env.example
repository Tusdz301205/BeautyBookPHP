APP_NAME=BeautyBook
BEAUTYBOOK_LEGACY_UI=false
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=Asia/Ho_Chi_Minh

APP_LOCALE=vi
APP_FALLBACK_LOCALE=vi
APP_FAKER_LOCALE=vi_VN

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3307
DB_DATABASE=beautybook_php
DB_USERNAME=beautybook
DB_PASSWORD=beautybook_local_only

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

# Mail: `log` writes messages to the log (development). For real delivery set MAIL_MAILER=smtp and fill the SMTP account of your
# provider (host, port 587 with MAIL_SCHEME=null for STARTTLS or 465 with MAIL_SCHEME=smtps, username, password) and a MAIL_FROM_ADDRESS
# on a domain you have verified with that provider. The password is a secret: keep it in the server environment, never in Git.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@beautybook.local"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# Legacy NestJS/React comparison stack. Development placeholders only.
NODE_ENV=development
POSTGRES_DB=glowbook_db
POSTGRES_USER=glowbook
POSTGRES_PASSWORD=glowbook_local
JWT_SECRET=local-development-access-secret-change-in-production
JWT_REFRESH_SECRET=local-development-refresh-secret-change-in-production
WEB_PORT=8080

# --- ZIP integrations (all off by default; secrets are never committed) -----------------------------------
# SePay bank-transfer webhook: POST /api/v1/payments/sepay/webhook, HMAC-SHA256 over "{timestamp}.{rawBody}".
# The ordinary endpoint only stores receipts. Wallet top-ups use the private Live-lab channel below
# (POST /api/v1/payments/sepay/wallet-live-lab/webhook) with its own secret; the lab is refused in production.
# Deposits. BEAUTYBOOK_PAYMENT_MODE=INTERNAL_WALLET holds each booking's 30% deposit from the customer's simulated wallet (Live lab only);
# empty with DIRECT_DEPOSIT_ENABLED=true makes the customer transfer the deposit to the business's own account (SePay connection per
# business). The two are exclusive and the wallet wins when both are set. Each connection has its own signing secret, stored encrypted with
# SEPAY_CONNECTION_ENCRYPTION_KEY: 64 hex characters, generate with `php -r "echo bin2hex(random_bytes(32)), PHP_EOL;"`, keep it outside Git,
# and never change it while connections exist (their secrets could no longer be opened).
BEAUTYBOOK_PAYMENT_MODE=
DIRECT_DEPOSIT_ENABLED=false
SEPAY_CONNECTION_ENCRYPTION_KEY=
# Production takes real money. SePay Test mode connections are refused there unless DIRECT_DEPOSIT_ALLOW_TEST=true (default: true outside
# production, false in production). SEPAY_ALLOWED_IPS optionally limits every SePay webhook to the addresses SePay publishes (comma
# separated IPs or CIDR; empty = no filter, each receipt is still HMAC-signed). Behind a reverse proxy set TRUSTED_PROXIES (proxy IPs or *)
# so the client address and https are read correctly. Check everything with: php artisan beautybook:payments-check
DIRECT_DEPOSIT_ALLOW_TEST=
SEPAY_ALLOWED_IPS=
TRUSTED_PROXIES=
WALLET_LIVE_LAB_ISOLATED=false
WALLET_LIVE_LAB_ENABLED=false
WALLET_LIVE_LAB_USER_IDS=
WALLET_LIVE_LAB_BUSINESS_IDS=
WALLET_LIVE_LAB_WEBHOOK_SECRET=
WALLET_LIVE_LAB_BANK_CODE=
WALLET_LIVE_LAB_ACCOUNT_NUMBER=
WALLET_LIVE_LAB_ACCOUNT_NAME=
WALLET_LIVE_LAB_MIN_TOPUP_VND=1000
WALLET_LIVE_LAB_MAX_TOPUP_VND=50000
WALLET_LIVE_LAB_MAX_TOTAL_VND=500000
SEPAY_WEBHOOK_ENABLED=false
SEPAY_ENVIRONMENT=test
SEPAY_WEBHOOK_SECRET=
SEPAY_WEBHOOK_BANK_GATEWAY=
SEPAY_WEBHOOK_ACCOUNT_NUMBER=

# Google Identity Services (ID-token flow, public client id only).
GOOGLE_CLIENT_ID=

# Device push through Firebase Cloud Messaging HTTP v1. FCM_SERVICE_ACCOUNT_FILE is a server path outside the repo.
# Push needs SESSION_DRIVER=database (a device is bound to its login session and only that driver can say the session is still alive).
PUSH_ENABLED=false
FCM_PROJECT_ID=
FCM_SERVICE_ACCOUNT_FILE=
# Browser (web push) channel: the PUBLIC web settings of the same Firebase project (Project settings > General > your web app, and
# Cloud Messaging > Web Push certificates > key pair). They identify the project, they are not secrets. All four must be set, together
# with PUSH_ENABLED=true, for the browser to be offered real push; the site must be served over HTTPS (or localhost).
FCM_WEB_API_KEY=
FCM_WEB_APP_ID=
FCM_WEB_SENDER_ID=
FCM_WEB_VAPID_KEY=
# Preview/test only (ignored outside local/testing): serve stand-ins for Google OAuth and FCM from this app. See docker-compose.preview.yml.
PUSH_TRIAL_SINK=false

# Private media: local (default) or r2 (private Cloudflare R2 bucket via the S3 API).
MEDIA_PRIVATE_DISK=local
R2_ENDPOINT=
R2_BUCKET_NAME=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_KEY_PREFIX=

# Build flags read by Vite at build time (set them in the shell that runs `npm run build`, not here):
#   VITE_FINANCE_WORKSPACE=true   shows the finance workspace (payments, wallet, deposits, payouts). Off by default.
