{
  "$schema": "https://www.schemastore.org/package.json",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "npm run build:laravel && npm run build:beautybook",
    "dev": "node node_modules/vite/bin/vite.js",
    "build:beautybook": "node node_modules/vite-beautybook/bin/vite.js build --config vite.beautybook.config.js",
    "build:laravel": "node node_modules/vite/bin/vite.js build"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "autoprefixer": "^10.4.0",
    "concurrently": "^10.0.3",
    "esbuild": "^0.27.7",
    "laravel-vite-plugin": "^3.1",
    "tailwindcss": "^4.0.0",
    "tailwindcss-beautybook": "npm:tailwindcss@^3.4.19",
    "vite": "^8.0.0",
    "vite-beautybook": "npm:vite@^5.4.1"
  },
  "optionalDependencies": {
    "@laravel/multiplex": "^0.4.1"
  },
  "dependencies": {
    "date-fns": "^4.4.0",
    "lucide-react": "^0.383.0",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hot-toast": "^2.6.0",
    "react-router-dom": "^6.30.4",
    "react-select": "^5.10.2",
    "recharts": "^2.15.4",
    "socket.io": "^4.8.4",
    "socket.io-client": "^4.8.3",
    "zustand": "^4.5.7"
  }
}
